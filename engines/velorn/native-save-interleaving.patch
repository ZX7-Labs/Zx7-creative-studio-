+++ b/electron/nativeSaveBarrier.test.mjs
@@ -0,0 +1,67 @@
+'use strict'
+import test from 'node:test'
+import assert from 'node:assert/strict'
+import os from 'node:os'
+import fs from 'node:fs/promises'
+import path from 'node:path'
+import barrier from './nativeSaveBarrier.cjs'
+const { maybePauseBeforeNativeProjectRename } = barrier
+
+const waitFile = async (file) => {
+  for (let i = 0; i < 60; i++) {
+    try { await fs.access(file); return }
+    catch (error) { if (error.code !== 'ENOENT') throw error }
+    await new Promise(resolve => setTimeout(resolve, 30))
+  }
+  throw new Error('Native-save test gate was never entered')
+}
+
+test('CI-only barrier cannot stall unrelated or unarmed saves', async () => {
+  const scratch = await fs.mkdtemp(path.join(os.tmpdir(), 'zx7-native-save-gate-'))
+  try {
+    const root = path.join(scratch, 'projects'), gate = path.join(scratch, 'gate')
+    await fs.mkdir(root)
+    await fs.mkdir(gate)
+    const before = { ...process.env }
+    try {
+      process.env.ZX7_CI_NATIVE_SAVE_GATE_DIR = gate
+      process.env.ZX7_CI_NATIVE_SAVE_PROJECTS_ROOT = root
+      delete process.env.CI
+      assert.equal(await maybePauseBeforeNativeProjectRename(path.join(root, 'item', 'project.comfystudio')), false)
+      process.env.CI = 'true'
+      assert.equal(await maybePauseBeforeNativeProjectRename(path.join(root, 'item', 'project.comfystudio')), false)
+      await fs.writeFile(path.join(gate, 'armed'), '1')
+      assert.equal(await maybePauseBeforeNativeProjectRename(path.join(scratch, 'outside', 'project.comfystudio')), false)
+      assert.equal(await maybePauseBeforeNativeProjectRename(path.join(root, 'item', 'unrelated.mov')), false)
+    } finally { process.env = before }
+  } finally { await fs.rm(scratch, { recursive: true, force: true }) }
+})
+
+test('real asynchronous barrier is held until explicit release and cleans markers', async () => {
+  const scratch = await fs.mkdtemp(path.join(os.tmpdir(), 'zx7-native-save-gate-'))
+  const before = { ...process.env }
+  try {
+    const root = path.join(scratch, 'projects'), gate = path.join(scratch, 'gate')
+    await fs.mkdir(root)
+    await fs.mkdir(gate)
+    process.env.CI = 'true'
+    process.env.ZX7_CI_NATIVE_SAVE_GATE_DIR = gate
+    process.env.ZX7_CI_NATIVE_SAVE_PROJECTS_ROOT = root
+    await fs.writeFile(path.join(gate, 'armed'), '1')
+    let completed = false
+    const pending = maybePauseBeforeNativeProjectRename(path.join(root, 'item', 'project.comfystudio')).then(result => {
+      completed = true
+      return result
+    })
+    await waitFile(path.join(gate, 'entered'))
+    assert.equal(completed, false)
+    await fs.writeFile(path.join(gate, 'release'), '1')
+    assert.equal(await pending, true)
+    for (const name of ['armed', 'entered', 'release']) {
+      await assert.rejects(fs.stat(path.join(gate, name)), { code: 'ENOENT' })
+    }
+  } finally {
+    process.env = before
+    await fs.rm(scratch, { recursive: true, force: true })
+  }
+})
