diff --git a/electron/nativeSaveBarrier.cjs b/electron/nativeSaveBarrier.cjs
new file mode 100644
--- /dev/null
+++ b/electron/nativeSaveBarrier.cjs
@@ -0,0 +1,65 @@
+'use strict'
+
+// Test-only fault boundary in an independently pinned CI Electron source child.
+// This is NOT a model, UI, remotely callable or production fault-injection API.
+const fs = require('node:fs/promises')
+const path = require('node:path')
+
+const sleep = (ms) => new Promise(resolve => setTimeout(resolve, ms))
+const safeMarker = async marker => {
+  const stat = await fs.lstat(marker)
+  if (!stat.isFile() || stat.isSymbolicLink()) {
+    throw new Error('Untrusted native-save test marker')
+  }
+}
+
+// Pause after the real atomic temporary file has been written, before rename.
+// The renderer and actual X11 UI remain live; the harness may edit concurrently
+// or kill the exact isolated CI Electron process while the write is pending.
+async function maybePauseBeforeNativeProjectRename(filePath) {
+  if (process.env.CI !== 'true') return false
+  const gateDir = process.env.ZX7_CI_NATIVE_SAVE_GATE_DIR
+  const workspaceRoot = process.env.ZX7_CI_NATIVE_SAVE_PROJECTS_ROOT
+  if (!gateDir || !workspaceRoot) return false
+  if (!path.isAbsolute(gateDir) || !path.isAbsolute(workspaceRoot)) {
+    throw new Error('Native-save test paths must be absolute')
+  }
+  const candidate = path.resolve(filePath)
+  const relative = path.relative(path.resolve(workspaceRoot), candidate)
+  if (path.basename(candidate) !== 'project.comfystudio' ||
+      !relative || relative === '..' || relative.startsWith('..' + path.sep) ||
+      path.isAbsolute(relative)) return false
+
+  const directory = await fs.lstat(gateDir)
+  if (!directory.isDirectory() || directory.isSymbolicLink()) {
+    throw new Error('Native-save test gate must be a real directory')
+  }
+  const armed = path.join(gateDir, 'armed')
+  try {
+    await safeMarker(armed)
+  } catch (error) {
+    if (error.code === 'ENOENT') return false
+    throw error
+  }
+
+  const entered = path.join(gateDir, 'entered')
+  const release = path.join(gateDir, 'release')
+  // Exclusive marker also prevents silently accepting a previous session.
+  await fs.writeFile(entered, String(process.pid) + '\n', { flag: 'wx', mode: 0o600 })
+  const deadline = Date.now() + 20000
+  while (Date.now() < deadline) {
+    try {
+      await safeMarker(release)
+      await fs.unlink(armed)
+      await fs.unlink(release)
+      await fs.unlink(entered)
+      return true
+    } catch (error) {
+      if (error.code !== 'ENOENT') throw error
+    }
+    await sleep(50)
+  }
+  throw new Error('Isolated native-save test barrier timed out without release')
+}
+
+module.exports = { maybePauseBeforeNativeProjectRename }
