+export async function runMcpAction(action, payload = {}) {
+  // Synchronous renderer commit entry, NOT Electron's debounced snapshot.
+  // GUI store mutations increment the source revision without a model token.
+  // Missing tokens on this patched MCP write path fail closed.
+  if (action === 'update_text_clip' && payload?.previewOnly !== true) {
+    const current = getZX7NativeRevision()
+    const expected = payload?.__zx7ExpectedRevision
+    if (!current || typeof expected !== 'string' || current !== expected) {
+      throw new Error('ZX7_STALE_NATIVE_REVISION')
+    }
+  }
+  return handleMcpAction({ action, payload })
