diff --git a/src/services/nativeSaveSequence.js b/src/services/nativeSaveSequence.js
new file mode 100644
--- /dev/null
+++ b/src/services/nativeSaveSequence.js
@@ -0,0 +1,21 @@
+// Serialize asynchronous native project saves at their single source owner.
+// Every invocation samples source state when its turn begins, not at enqueue.
+export const createSerializedSave = () => {
+  let tail = Promise.resolve()
+  return (task) => {
+    if (typeof task !== 'function') {
+      return Promise.reject(new TypeError('Save operation must be a function'))
+    }
+    const active = tail.then(task, task)
+    // One failure must not poison later *independently requested* saves.
+    // This never retries the failed write.
+    tail = active.then(() => undefined, () => undefined)
+    return active
+  }
+}
+
+// Never discard the only in-memory original if persistence failed or if
+// a human/editor action made new unsaved changes after the save snapshot.
+export const canDiscardSavedProject = (saved, dirty, sameProject) => (
+  saved === true && dirty === false && sameProject === true
+)
diff --git a/src/services/nativeSaveSequence.test.mjs b/src/services/nativeSaveSequence.test.mjs
new file mode 100644
--- /dev/null
+++ b/src/services/nativeSaveSequence.test.mjs
@@ -0,0 +1,80 @@
+import assert from 'node:assert/strict'
+import test from 'node:test'
+import { createSerializedSave, canDiscardSavedProject } from './nativeSaveSequence.js'
+import {
+  getProjectEditEpoch, markProjectDirty, markProjectClean, isProjectDirty,
+} from './projectDirtyTracker.js'
+
+const deferred = () => {
+  let resolve, reject
+  const promise = new Promise((res, rej) => { resolve = res; reject = rej })
+  return { promise, resolve, reject }
+}
+
+test('overlapping saves are strictly ordered and take source state when started', async () => {
+  const run = createSerializedSave()
+  const gate = deferred()
+  const events = []
+  let activeState = 'first'
+  const first = run(async () => {
+    events.push(['start', activeState])
+    await gate.promise
+    events.push(['finish', activeState])
+    return 'disk-1'
+  })
+  const second = run(async () => {
+    events.push(['start', activeState])
+    return 'disk-2'
+  })
+  await Promise.resolve()
+  await Promise.resolve()
+  assert.deepEqual(events, [['start', 'first']])
+  activeState = 'human-edit'
+  gate.resolve()
+  assert.equal(await first, 'disk-1')
+  assert.equal(await second, 'disk-2')
+  assert.deepEqual(events, [
+    ['start', 'first'], ['finish', 'human-edit'], ['start', 'human-edit'],
+  ])
+})
+
+test('failed write does not replay; subsequent explicit save is allowed', async () => {
+  const run = createSerializedSave()
+  const gate = deferred()
+  let writes = 0
+  const first = run(async () => { writes++; await gate.promise; throw Error('disk full') })
+  const second = run(async () => { writes++; return 'saved' })
+  await Promise.resolve()
+  gate.resolve()
+  await assert.rejects(first, /disk full/)
+  assert.equal(await second, 'saved')
+  assert.equal(writes, 2)
+})
+
+test('invalid task is rejected without mutating sequence', async () => {
+  const run = createSerializedSave()
+  await assert.rejects(run('not a task'), /function/)
+  assert.equal(await run(async () => 'still works'), 'still works')
+})
+
+test('project is never discarded after failed save, newer edit or project switch', () => {
+  assert.equal(canDiscardSavedProject(true, false, true), true)
+  for (const candidate of [
+    [false, false, true], [true, true, true], [true, false, false],
+    [undefined, false, true], [true, undefined, true], [1, false, true],
+  ]) assert.equal(canDiscardSavedProject(...candidate), false)
+})
+
+test('dirty edit epoch detects intervening human changes without hiding them', () => {
+  markProjectClean()
+  const before = getProjectEditEpoch()
+  assert.equal(isProjectDirty(), false)
+  markProjectDirty()
+  assert.equal(isProjectDirty(), true)
+  assert.equal(getProjectEditEpoch(), before + 1)
+  markProjectDirty()
+  assert.equal(getProjectEditEpoch(), before + 2)
+  markProjectClean()
+  assert.equal(getProjectEditEpoch(), before + 2)
+  assert.equal(isProjectDirty(), false)
+})
